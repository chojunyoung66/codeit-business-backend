# 데이터베이스 연결 URL
DATABASE_URL="postgresql://USER@localhost:5432/DB_NAME?schema=public"

# JWT 서명 시크릿
JWT_SECRET=""

# 서버 포트
PORT=3000

# FE origin (CORS credentials용, 여러 개면 콤마로 구분)
# 주의: * 는 credentials:true 와 함께 쓸 수 없음
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:3000"

# 실행 환경
NODE_ENV=development
